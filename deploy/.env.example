# 复制成 .env 再改。compose 不展开 ~,要写绝对路径或用 ${HOME}。

# 镜像。dev 环境由流水线写入形如 <registry>/agentre/agentred:dev.<short-sha>
AGENTRED_IMAGE=gitea.icodef.com/agentre/agentred:latest

# 工作区根目录。**容器内外必须是同一个绝对路径**,compose 里两侧用的就是这一个变量
AGENTRED_WORKSPACE=${HOME}/code

# 映射到宿主的端口。桥接网络下 agentred pair 广播的地址不可用,见 README
AGENTRED_PORT=7456

# 这台机器在账号设备列表里显示的名字。不设就是 agentred；容器 hostname 默认是
# 容器 ID,不钉住的话每次重建容器名字都会变一次
AGENTRED_HOSTNAME=agentred

# 镜像是本机 docker build 出来的、registry 上没有时设成 never。从 registry 拉就别动
# AGENTRED_PULL_POLICY=never

# 下面这些不写就用默认值(容器内 /root/... 对应宿主 ${HOME}/...),
# 只有配置不在 home 下时才需要覆盖
# AGENTRED_STATE_DIR=${HOME}/.config/agentred
# AGENTRE_DATA_DIR=${HOME}/.config/agentre
# CLAUDE_DIR=${HOME}/.claude
# CLAUDE_JSON=${HOME}/.claude.json
# CODEX_DIR=${HOME}/.codex
# PI_DIR=${HOME}/.pi
# AGENTS_DIR=${HOME}/.agents
# SSH_DIR=${HOME}/.ssh
# GITCONFIG=${HOME}/.gitconfig
