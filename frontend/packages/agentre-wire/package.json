{
  "name": "@agentre-hub/agentre-wire",
  "version": "0.1.0",
  "description": "Agentre wire 协议：Protobuf schema、生成的 TS 编解码与黄金样本",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./fixtures/*.json": "./fixtures/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "fixtures",
    "proto",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "proto:generate": "buf generate",
    "proto:check": "buf lint && buf breaking --against proto/baseline.binpb && pnpm run proto:generate && git diff --exit-code -- src/gen ../../../pkg/wire",
    "test": "vitest run"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.14.0"
  },
  "devDependencies": {
    "@bufbuild/protobuf": "2.14.0",
    "@bufbuild/buf": "1.72.0",
    "@bufbuild/protoc-gen-es": "2.14.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.1"
  }
}
