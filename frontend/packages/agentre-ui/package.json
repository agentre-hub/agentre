{
  "name": "@agentre-ai/agentre-ui",
  "version": "0.1.0",
  "description": "Agentre 跨端共享前端层：design tokens + AI 对话流渲染器",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./tokens.css": "./styles/tokens.css",
    "./code-highlight.css": "./styles/code-highlight.css",
    "./base.css": "./styles/base.css",
    "./toast.css": "./styles/toast.css",
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "default": "./dist/i18n/index.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "styles"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ./scripts/copy-assets.mjs",
    "prepare": "tsc -p tsconfig.build.json && node ./scripts/copy-assets.mjs",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@iconify/react": "^6.0.0",
    "@tiptap/core": "^3.23.4",
    "@tiptap/extension-document": "^3.23.4",
    "@tiptap/extension-hard-break": "^3.23.4",
    "@tiptap/extension-paragraph": "^3.23.4",
    "@tiptap/extension-text": "^3.23.4",
    "@tiptap/extensions": "^3.23.4",
    "@tiptap/pm": "^3.23.4",
    "@tiptap/react": "^3.23.4",
    "i18next": "^26.0.0",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.0",
    "sonner": "^2.0.0"
  },
  "dependencies": {
    "@iconify/react": "^6.0.2",
    "@iconify/types": "^2.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.400.0",
    "pinyin-pro": "^3.28.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@tiptap/core": "^3.23.4",
    "@tiptap/extension-document": "^3.23.4",
    "@tiptap/extension-hard-break": "^3.23.4",
    "@tiptap/extension-paragraph": "^3.23.4",
    "@tiptap/extension-text": "^3.23.4",
    "@tiptap/extensions": "^3.23.4",
    "@tiptap/pm": "^3.23.4",
    "@tiptap/react": "^3.23.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "i18next": "^26.3.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.8",
    "sonner": "^2.0.7",
    "typescript": "^5.9.3",
    "vitest": "^4.1.1"
  }
}
